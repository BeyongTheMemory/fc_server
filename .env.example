# 本机启动配置模板:复制为 .env.local 并填入真实值(.env.local 不提交、不进镜像)。
#   cp .env.example .env.local
# `go run .` 启动时自动读取 .env.local;同名的真实环境变量优先。完整变量列表见 README「配置」。

PORT=8081

# 微信小游戏(必填)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# MySQL(可选;不填则停用 MySQL 备份)。变量名与微信云托管注入的一致
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fc

# Redis(必填)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 日志
LOG_DIR=logs
LOG_CONSOLE=true
